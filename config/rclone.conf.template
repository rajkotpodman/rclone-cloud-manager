# Sample rclone configuration template
# DO NOT COMMIT REAL TOKENS OR SECRETS INTO VERSION CONTROL

# [my-gdrive]
# type = drive
# client_id = YOUR_CLIENT_ID
# client_secret = YOUR_CLIENT_SECRET
# scope = drive
# token = {"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}

# [my-s3]
# type = s3
# provider = AWS
# env_auth = false
# access_key_id = YOUR_ACCESS_KEY
# secret_access_key = YOUR_SECRET_KEY
# region = us-east-1

# [my-onedrive]
# type = onedrive
# token = {"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}
# drive_id = YOUR_DRIVE_ID
# drive_type = personal
